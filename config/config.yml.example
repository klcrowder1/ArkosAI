# API configuration
api:
  enabled: true
  host: 0.0.0.0
  port: 5001
  base_path: /api
  cors_origins:
    - "*"
  rate_limit:
    rate: 100
    per: 60
    burst: 200
  versioning:
    default_version: v1
    current_version: v1
    supported_versions:
      - v1
      - v2
    redirect_deprecated: true
    allow_version_override: true
  docs_url: /api/docs
  redoc_url: /api/redoc
  openapi_url: /api/openapi.json
  debug: false

mqtt:
  host: mqtt
  port: 1883
  # username: user
  # password: pass
  # client_id: arkos
  # topic_prefix: arkos

# Global notification configuration
notifications:
  # Console notifications (for debugging)
  console:
    enabled: true
    pretty_print: true
    include_data: false
    log_level: INFO
  
  # MQTT notifications
  mqtt:
    enabled: false
    host: mqtt
    port: 1883
    # username: user
    # password: pass
    topic_prefix: arkos/notifications
  
  # Webhook notifications
  webhook:
    enabled: false
    urls:
      - http://example.com/webhook
    method: POST
    timeout: 10
    headers:
      Content-Type: application/json
    include_snapshot: true
    include_clip: false
    verify_ssl: true
    # base_url: http://example.com/media

# Global event configuration
events:
  enabled: true
  # Global filter that applies to all event types
  global_filter:
    min_score: 0.6
    min_duration: 2.0
    severities:
      - alert
      - detection
  # Event type-specific filters
  filters:
    tracked_object:
      min_score: 0.7
      labels:
        - person
        - car
        - truck
      exclude_labels:
        - dog
        - cat
    audio:
      min_score: 0.8
      min_duration: 3.0
    api:
      min_duration: 5.0
  
  # Event correlation configuration
  correlation:
    enabled: true
    window: 30
    spatial_threshold: 0.1
    severity_upgrade: true
    cross_camera: false
    rules:
      audio_object:
        speech_person: true
        bark_dog: true
        meow_cat: true
        engine_vehicle: true

# Global record configuration
record:
  # Global retention configuration
  retain:
    days: 7
    mode: all  # all, motion, active_objects
  
  # Sync recordings with disk
  sync_recordings: true
  
  # Expire interval in minutes
  expire_interval: 60
  
  # Tiered storage configuration
  tiered_storage:
    enabled: true
    check_interval: 3600  # Check interval in seconds
    tiers:
      # Hot tier (fast, expensive storage for recent recordings)
      - name: hot
        path: /media/ssd/recordings
        type: hot
        priority: 0
        min_age_days: 0
        max_age_days: 7
        min_free_space_mb: 5000
        readonly: false
        events_only: false
      
      # Warm tier (medium-speed storage for older recordings)
      - name: warm
        path: /media/hdd/recordings
        type: warm
        priority: 100
        min_age_days: 7
        max_age_days: 30
        min_free_space_mb: 10000
        readonly: false
        events_only: false
      
      # Cold tier (slow, inexpensive storage for archival recordings)
      - name: cold
        path: /media/nas/recordings
        type: cold
        priority: 200
        min_age_days: 30
        max_age_days: null  # No maximum age
        min_free_space_mb: 50000
        readonly: false
        events_only: true  # Only store event recordings in this tier

# Storage configuration
storage:
  # Backup and recovery configuration
  backup:
    # Backup destinations
    destinations:
      # Local backup destination
      - name: local_backup
        type: local
        path: /media/backup/arkos
        retention_days: 30
        max_backups: 10
      
      # Remote backup destination (SSH/rsync)
      - name: remote_backup
        type: remote
        path: /backup/arkos
        host: backup-server.example.com
        user: backup-user
        ssh_key: /config/ssh/id_rsa
        retention_days: 60
        max_backups: 20
      
      # Cloud backup destination (rclone)
      - name: cloud_backup
        type: cloud
        path: arkos-backups
        provider: gdrive
        rclone_config: /config/rclone.conf
        retention_days: 90
        max_backups: 30
    
    # Scheduled backups
    schedules:
      # Daily configuration backup
      - name: daily_config_backup
        destination: local_backup
        content_type: config
        frequency: daily
        time: "02:00"
        enabled: true
      
      # Weekly full backup to remote server
      - name: weekly_full_backup
        destination: remote_backup
        content_type: all
        frequency: weekly
        day: 0  # Sunday
        time: "03:00"
        enabled: true
      
      # Monthly cloud backup
      - name: monthly_cloud_backup
        destination: cloud_backup
        content_type: all
        frequency: monthly
        day: 1  # First day of the month
        time: "04:00"
        enabled: true
    
    # Backup verification
    verification:
      enabled: true
      verify_after_backup: true
      auto_verify_interval: 168  # 7 days in hours

# Camera-specific configuration
cameras:
  # Standard camera example
  test:
    ffmpeg:
      inputs:
        - path: /media/arkos/car-stopping.mp4
          input_args: -re -stream_loop -1 -fflags +genpts
          roles:
            - detect
            - rtmp
    detect:
      height: 1080
      width: 1920
      fps: 5
      # Configure which model purposes to use for this camera
      # If not specified, the general purpose model will be used
      model_purposes:
        - general
        - vehicle
        - license_plate
    
    # Notification configuration for this camera
    notifications:
      enabled: true
      # Notification triggers (tracked_object, audio, api)
      triggers:
        - tracked_object
        - audio
        - api
      # Object filters
      required_objects:
        - person
        - car
        - truck
      filtered_objects:
        - dog
        - cat
      # Zone filters
      required_zones:
        - driveway
        - entrance
      filtered_zones:
        - ignore_zone
      # Cooldown period in seconds
      cooldown: 60
      # Notification content
      include_snapshot: true
      include_preview: false
      include_clip: false
      # Notification services to use (if empty, all enabled services will be used)
      services:
        - mqtt
        - webhook
        - console

# Detector configuration with multi-model support
detectors:
  cpu:
    type: cpu
    num_threads: 3
    # Multiple models configuration
    models:
      # General purpose model (default)
      - path: /models/yolov7-320.pt
        width: 320
        height: 320
        model_type: yologeneric
        purpose: general
        priority: 100
      
      # Person-specific model (higher resolution, specialized for people detection)
      - path: /models/person-model-640.pt
        width: 640
        height: 640
        model_type: yologeneric
        purpose: person
        priority: 50
      
      # Vehicle-specific model
      - path: /models/vehicle-model-512.pt
        width: 512
        height: 512
        model_type: yologeneric
        purpose: vehicle
        priority: 50
      
      # License plate recognition model
      - path: /models/license-plate-model-416.pt
        width: 416
        height: 416
        model_type: yologeneric
        purpose: license_plate
        priority: 30
  
  # Custom model detector configuration
  custom:
    type: custom
    num_threads: 4
    model_format: "onnx"  # Options: tflite, onnx, pytorch
    # Custom preprocessing configuration
    custom_preprocessing:
      mean: [0.485, 0.456, 0.406]  # RGB mean values for normalization
      std: [0.229, 0.224, 0.225]   # RGB standard deviation values for normalization
      transforms:
        - rgb_to_bgr                # Convert RGB to BGR if needed
        - hwc_to_chw                # Convert HWC to CHW if needed
    # Models configuration
    models:
      # Custom general purpose model
      - path: /models/custom/my-custom-model.onnx
        width: 640
        height: 640
        model_type: yologeneric
        purpose: general
        priority: 100
        input_tensor: nchw         # Input tensor format (nchw or nhwc)
        input_pixel_format: rgb    # Input pixel format (rgb or bgr)
        input_dtype: float         # Input data type (float, float_denorm, or int)
        # Custom label mapping
        labelmap:
          0: person
          1: car
          2: truck
          3: bicycle
          4: motorcycle
          5: bus
      
      # Custom specialized model for face detection
      - path: /models/custom/face-detection.onnx
        width: 320
        height: 320
        model_type: ssd
        purpose: face
        priority: 50
        input_tensor: nhwc
        input_pixel_format: rgb
        input_dtype: float
        # Custom label mapping
        labelmap:
          0: face

cameras:
  # Standard camera example
  test:
    ffmpeg:
      inputs:
        - path: /media/arkos/car-stopping.mp4
          input_args: -re -stream_loop -1 -fflags +genpts
          roles:
            - detect
            - rtmp
    detect:
      height: 1080
      width: 1920
      fps: 5
      # Configure which model purposes to use for this camera
      # If not specified, the general purpose model will be used
      model_purposes:
        - general
        - vehicle
        - license_plate
  
  # PTZ camera example
  ptz_camera:
    type: ptz
    ffmpeg:
      inputs:
        - path: rtsp://username:password@camera-ip:554/stream
          roles:
            - detect
            - record
    ptz:
      enabled: true
      protocol: onvif
      default_speed: 0.5
      presets:
        home:
          name: Home
          position:
            pan: 0.0
            tilt: 0.0
            zoom: 1.0
          home: true
        entrance:
          name: Entrance
          position:
            pan: 45.0
            tilt: -10.0
            zoom: 2.0
      autotracking:
        enabled: true
        tracking_objects:
          - person
        tracking_timeout: 30
  
  # Thermal camera example
  thermal_camera:
    type: thermal
    ffmpeg:
      inputs:
        - path: rtsp://username:password@thermal-camera-ip:554/stream
          roles:
            - detect
            - record
    thermal:
      enabled: true
      unit: celsius
      min_temp: 0.0
      max_temp: 100.0
      palette: iron
      show_temp: true
      show_hotspot: true
      alarms:
        high_temp:
          enabled: true
          threshold_high: 38.0
          duration: 5
  
  # Fisheye camera example
  fisheye_camera:
    type: fisheye
    ffmpeg:
      inputs:
        - path: rtsp://username:password@fisheye-camera-ip:554/stream
          roles:
            - detect
            - record
    fisheye:
      enabled: true
      dewarper:
        enabled: true
        method: opencv
        center: [0.5, 0.5]
        radius: 1.0
        fov: 180.0
      panorama: true
      panorama_width: 1920
      panorama_height: 480
  
  # Multi-sensor camera example
  multi_sensor_camera:
    type: multi_sensor
    multi_sensor:
      enabled: true
      sensors:
        front:
          name: Front Sensor
          stream_url: rtsp://username:password@camera-ip:554/stream1
          position: front
        left:
          name: Left Sensor
          stream_url: rtsp://username:password@camera-ip:554/stream2
          position: left
        right:
          name: Right Sensor
          stream_url: rtsp://username:password@camera-ip:554/stream3
          position: right
      groups:
        perimeter:
          name: Perimeter Group
          sensors:
            - front
            - left
            - right
          stitching: true
  
  # Doorbell camera example
  doorbell_camera:
    type: doorbell
    ffmpeg:
      inputs:
        - path: rtsp://username:password@doorbell-camera-ip:554/stream
          roles:
            - detect
            - record
            - audio
    doorbell:
      enabled: true
      button_enabled: true
      button_detection_method: api
      audio_enabled: true
      two_way_audio: true
      events:
        button_press:
          name: Button Press
          trigger_type: button
          notify: true
        person_detected:
          name: Person Detected
          trigger_type: object
          trigger_objects:
            - person
          notify: true
    
    # Event filtering configuration
    events:
      enabled: true
      # Global filter that applies to all event types for this camera
      global_filter:
        min_score: 0.65
        min_duration: 1.5
        zones:
          - entrance
          - driveway
        categories:
          - security
          - monitoring
      # Event type-specific filters
      filters:
        tracked_object:
          min_score: 0.75
          labels:
            - person
            - car
          exclude_zones:
            - ignore_zone
          confidence_levels:
            - high
            - medium
        audio:
          min_score: 0.85
          sources:
            - microphone
        api:
          custom_filters:
            trigger_type: manual
      
      # Event correlation configuration
      correlation:
        enabled: true
        window: 15
        spatial_threshold: 0.2
        severity_upgrade: true
        cross_camera: false
        rules:
          audio_object:
            speech_person: true
            doorbell_person: true
